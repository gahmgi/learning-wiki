#!/bin/sh
# 학습 위키는 개인 계정 전용이다. 다른 신원(특히 회사 메일)으로 커밋되려 하면 여기서 멈춘다.
EXPECTED="gahmhg@gmail.com"
AUTHOR=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p')
COMMITTER=$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p')

if [ "$AUTHOR" != "$EXPECTED" ] || [ "$COMMITTER" != "$EXPECTED" ]; then
	echo ""
	echo "  ✋ 커밋을 멈췄습니다. 학습 위키는 개인 계정 전용입니다."
	echo ""
	echo "     있어야 할 계정 : $EXPECTED"
	echo "     작성자         : ${AUTHOR:-（신원 없음）}"
	echo "     커미터         : ${COMMITTER:-（신원 없음）}"
	echo ""
	echo "     고치는 방법:"
	echo "       git config --local user.email '$EXPECTED'"
	echo ""
	exit 1
fi
