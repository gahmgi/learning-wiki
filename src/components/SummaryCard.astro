---
// Key takeaway: one-line conclusion plus numbered supporting points, set between two hairlines.
// Use once, at the top of a page.
interface Props {
	title: string;
	points?: string[];
}
const { title, points = [] } = Astro.props;
---

<div class="wiki-gist not-content">
	<p class="wiki-gist-title">{title}</p>
	{points.length > 0 && <ol>{points.map((p) => <li>{p}</li>)}</ol>}
	<slot />
</div>
