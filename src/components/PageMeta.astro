---
// Overrides Starlight's MarkdownContent: lead sentence above the body; on narrow screens the
// provenance block (status, sources) follows the body because the right margin is hidden there.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { pageInfo, joinDots } from '../lib/meta';
import Provenance from './Provenance.astro';

const { entry } = Astro.locals.starlightRoute;
const { isLearning } = pageInfo(entry);
---

{isLearning && entry.data.description && <p class="wiki-lead">{joinDots(entry.data.description)}</p>}
<Default><slot /></Default>
{
	isLearning && (
		<div class="wiki-provenance-inline">
			<Provenance />
		</div>
	)
}

<script>
	// Heading link icons: copy the section URL instead of only changing the hash, and say so.
	// If the clipboard is unavailable, fall back to the plain anchor jump.
	document.addEventListener('click', async (event) => {
		const link = (event.target as Element | null)?.closest?.('a.sl-anchor-link');
		if (!(link instanceof HTMLAnchorElement) || event.metaKey || event.ctrlKey || event.shiftKey) return;
		event.preventDefault();
		const url = new URL(link.getAttribute('href') ?? '', location.href).href;
		try {
			await navigator.clipboard.writeText(url);
		} catch {
			location.href = url;
			return;
		}
		history.replaceState(null, '', url);
		link.dataset.copied = '';
		link.setAttribute('aria-label', '링크를 복사했습니다');
		clearTimeout(Number(link.dataset.timer));
		link.dataset.timer = String(
			setTimeout(() => {
				delete link.dataset.copied;
				link.removeAttribute('aria-label');
			}, 1600),
		);
	});
	for (const a of document.querySelectorAll('a.sl-anchor-link')) a.setAttribute('title', '이 부분 링크 복사');
</script>
