---
// Overrides Starlight's MarkdownContent: lead sentence above the body; on narrow screens the
// provenance block (status, sources) follows the body because the right margin is hidden there.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { pageInfo, joinDots } from '../lib/meta';
import Provenance from './Provenance.astro';

const { entry } = Astro.locals.starlightRoute;
const { isLearning } = pageInfo(entry);
---

{isLearning && entry.data.description && <p class="wiki-lead">{joinDots(entry.data.description)}</p>}
<Default><slot /></Default>
{
	isLearning && (
		<div class="wiki-provenance-inline">
			<Provenance />
		</div>
	)
}
