---
// Step flow diagram in plain HTML/CSS (no runtime JS, no Mermaid).
// owner: who does the step (e.g. 'AI', '아티스트'). human: true highlights steps people must own.
interface Step {
	title: string;
	detail?: string;
	owner?: string;
	human?: boolean;
}
interface Props {
	caption?: string;
	steps: Step[];
}
const { caption, steps } = Astro.props;
---

<figure class="wiki-flow not-content">
	<ol>
		{
			steps.map((s, i) => (
				<li class:list={{ human: s.human }}>
					<span class="num" aria-hidden="true">{i + 1}</span>
					<div>
						<p class="title">
							{s.title}
							{s.owner && <span class="owner">{s.owner}</span>}
						</p>
						{s.detail && <p class="detail">{s.detail}</p>}
					</div>
				</li>
			))
		}
	</ol>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
