---
// Step flow as numbered rows (no runtime JS, no boxes).
// owner: who does the step. human: true marks steps a person must judge and own (accent on the owner).
interface Step {
	title: string;
	detail?: string;
	owner?: string;
	human?: boolean;
}
interface Props {
	caption?: string;
	steps: Step[];
}
const { caption, steps } = Astro.props;
---

<figure class="wiki-flow not-content">
	{caption && <figcaption>{caption}</figcaption>}
	<ol>
		{
			steps.map((s, i) => (
				<li class:list={{ human: s.human }}>
					<span class="n">{String(i + 1).padStart(2, '0')}</span>
					<span class="body">
						<span class="title">{s.title}</span>
						{s.detail && <span class="detail">{s.detail}</span>}
					</span>
					{s.owner && <span class="owner">{s.human ? `${s.owner} · 사람 판단` : s.owner}</span>}
				</li>
			))
		}
	</ol>
</figure>
