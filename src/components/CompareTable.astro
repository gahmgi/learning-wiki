---
// Comparison table. columns: header labels (first = row-label column). rows: cell arrays.
// highlight: optional column index to emphasize.
interface Props {
	caption?: string;
	columns: string[];
	rows: string[][];
	highlight?: number;
}
const { caption, columns, rows, highlight } = Astro.props;
---

<div class="wiki-compare not-content">
	<table>
		{caption && <caption>{caption}</caption>}
		<thead>
			<tr>{columns.map((c, i) => <th scope="col" class:list={{ hl: i === highlight }}>{c}</th>)}</tr>
		</thead>
		<tbody>
			{
				rows.map((r) => (
					<tr>
						{r.map((cell, i) =>
							i === 0 ? <th scope="row">{cell}</th> : <td class:list={{ hl: i === highlight }}>{cell}</td>,
						)}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
